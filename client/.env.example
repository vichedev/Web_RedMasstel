VITE_PORT=5173

# En desarrollo, deja paths relativos para usar el proxy de Vite.
# En producción, define la URL absoluta del backend (mismo dominio recomendado
# para que las cookies httpOnly funcionen con sameSite=lax/strict).
VITE_API_URL=/api/v1
VITE_STATIC_URL=

# Solo se usa por Vite en desarrollo (no se inyecta al bundle).
VITE_BACKEND_URL=http://localhost:3000

# EmailJS — restringe el dominio permitido en el panel de EmailJS antes de prod.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_CONTACT=
VITE_EMAILJS_TEMPLATE_SUBSCRIBE=
VITE_ADMIN_EMAIL=admin@redmaastel.ec

# WhatsApp (formato E.164 sin "+", ej: 593999999999).
# Si queda vacío, se usa VITE_WHATSAPP_DEFAULT como fallback.
VITE_WHATSAPP_DEFAULT=
VITE_WHATSAPP_REDMAASTEL=
